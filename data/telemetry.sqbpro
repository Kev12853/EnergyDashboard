    id,
    tariff_code,
    agreement_type,
    valid_from,
    valid_to
FROM octopus_agreements
WHERE agreement_type = 'import'
ORDER BY valid_from DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
